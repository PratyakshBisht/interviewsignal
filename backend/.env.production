# Production Environment Variables
APP_SECRET_KEY=production_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub OAuth
GITHUB_CLIENT_ID=${PRODUCTION_GITHUB_CLIENT_ID}
GITHUB_CLIENT_SECRET=${PRODUCTION_GITHUB_CLIENT_SECRET}
GITHUB_REDIRECT_URI=https://interviewsignal.app/auth/callback

# Database
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}
REDIS_URL=redis://${REDIS_HOST}:6379/0

# OpenAI
OPENAI_API_KEY=${PRODUCTION_OPENAI_API_KEY}

# URLs
FRONTEND_URL=https://interviewsignal.app
BACKEND_URL=https://api.interviewsignal.app

# Production Settings
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# Security
CORS_ALLOWED_ORIGINS=https://interviewsignal.app,https://*.interviewsignal.app
ALLOWED_HOSTS=localhost,127.0.0.1,interviewsignal.app,api.interviewsignal.app

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
NEW_RELIC_LICENSE_KEY=${NEW_RELIC_LICENSE_KEY}

# Deployment
WORKERS=4
PORT=8000
HOST=0.0.0.0
